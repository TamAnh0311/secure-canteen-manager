# ============================================================
# Canteen Manager — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# --- Postgres ---
POSTGRES_USER=canteen
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=canteen_db
# Full DSN consumed by NestJS TypeORM (wired in backend-foundation phase)
DATABASE_URL=postgresql://canteen:change_me_in_production@postgres:5432/canteen_db

# --- Backend ---
BACKEND_PORT=3000
JWT_SECRET=change_me_32_chars_minimum_random_here
JWT_EXPIRES_IN=12h

# --- Seed: initial admin operator (used by `npm run seed`) ---
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change_me_admin_password

# --- OMR Service ---
OMR_PORT=8000
# URL the backend uses to call the omr-service (internal docker network)
OMR_SERVICE_URL=http://omr-service:8000
# Timeout for OMR service HTTP calls in milliseconds
OMR_SERVICE_TIMEOUT_MS=30000
# Software workflow switch. Keep production on issued until the Phase 7 release gates pass.
OMR_OPERATIONAL_FORM_MODE=issued
OMR_OPERATIONAL_FORM_GENERATION=issued-v1
# Secret token used by hardware scanning agents (min 16 chars)
AGENT_TOKEN=change_me_min_16_chars_secret
# Directory where raw scan images are persisted (created automatically, mode 0700)
SCAN_STORAGE_DIR=./data/scans
# Per-credential upload admission controls. Excess rate/concurrency returns 429;
# full queue or high storage usage returns 503 before scan persistence.
SCAN_RATE_LIMIT_PER_MINUTE=60
KIOSK_LOOKUP_RATE_LIMIT_PER_MINUTE=10
SCAN_MAX_CONCURRENT_PER_CREDENTIAL=2
SCAN_MAX_PENDING=500
SCAN_STORAGE_HIGH_WATERMARK=0.90
# REQUIRED in production. The facility data owner must approve a positive duration
# covering the active scan store. Do not copy a guessed value from another site.
# SCAN_RETENTION_DAYS=<owner-approved-positive-days>
# SCANNER_SERVICE_DATE_MAX_PAST_DAYS=<owner-approved-non-negative-days>
# SCANNER_SERVICE_DATE_MAX_FUTURE_DAYS=<owner-approved-non-negative-days>
# Scanner webhook secrets/origin are required when scanner mode is enabled.
# Use two different secrets; the artifact origin must be the scanner HTTPS origin.
# SCANNER_CALLBACK_TOKEN=<secret-at-least-16-chars>
# SCANNER_ARTIFACT_TOKEN=<different-secret-at-least-16-chars>
# SCANNER_ARTIFACT_ORIGIN=https://scanner.example.test
# SCANNER_ARTIFACT_RETENTION_DAYS=<match-scanner-artifact-retention>
SCANNER_WEBHOOK_MAX_PAYLOAD_BYTES=524288
SCANNER_ARTIFACT_MAX_BYTES=10485760
SCANNER_ARTIFACT_TIMEOUT_MS=15000
SCAN_WORKFLOW_MODE=legacy_omr

# --- Frontend (nginx, no runtime env) ---
FRONTEND_PORT=8080

# --- Legacy SQL Server 2005 read-only sync ---
# All vars optional: app boots and operates normally with no legacy box configured.
# Set LEGACY_SYNC_ENABLED=true to activate the cron scheduler.
#
# TLS strategy (three tiers — pick the one that fits your network):
#
#   Tier 1 — trusted LAN, no TLS (default):
#     LEGACY_SQL_ENCRYPT=false
#     Simplest; use when SQL Server is on a private VLAN.
#
#   Tier 2 — encrypted, OpenSSL 3 / Node 18+:
#     LEGACY_SQL_ENCRYPT=true
#     LEGACY_SQL_TRUST_CERT=true
#     LEGACY_SQL_TLS_MIN_VERSION=TLSv1
#     OpenSSL 3 dropped TLS 1.0 from its default security level.
#     cryptoCredentialsDetails.minVersion re-enables it per-connection
#     without touching global OpenSSL config.
#
#   Tier 3 — Windows / NTLM authentication:
#     LEGACY_SQL_ENCRYPT=true + NODE_OPTIONS=--openssl-legacy-provider at startup
#     Required when the server uses NTLM auth (depends on MD4, disabled in OpenSSL 3).
#     The legacy provider must be active before tedious negotiates the auth handshake.
#
# SQL Server 2005 speaks TDS 7.2 — keep LEGACY_SQL_TDS_VERSION=7_2 (default).
#
# Query must alias columns to: legacyId, name, department, zone, isActive
# Example (adapt to your schema):
#   SELECT CAST(EmployeeID AS NVARCHAR(255)) AS legacyId,
#          FullName AS name, Department AS department,
#          NULL AS zone, 1 AS isActive
#   FROM dbo.Employees
#
LEGACY_SQL_HOST=
LEGACY_SQL_PORT=1433
LEGACY_SQL_USER=
LEGACY_SQL_PASS=
LEGACY_SQL_DB=
LEGACY_SQL_ENCRYPT=false
LEGACY_SQL_TRUST_CERT=true
LEGACY_SQL_TDS_VERSION=7_2
# LEGACY_SQL_TLS_MIN_VERSION=TLSv1   # uncomment for Tier 2 encrypted connections
LEGACY_SQL_POOL_SIZE=5
LEGACY_SQL_QUERY_TIMEOUT_MS=60000
# LEGACY_SQL_QUERY=SELECT CAST(EmployeeID AS NVARCHAR(255)) AS legacyId, FullName AS name, Department AS department, NULL AS zone, 1 AS isActive FROM dbo.Employees
LEGACY_SYNC_ENABLED=false
LEGACY_SYNC_CRON=0 */4 * * *

# --- Vision / OMR thresholds (configurable by admin in later phase) ---
# ICR softmax confidence threshold — digits below this require human verify
ICR_CONFIDENCE_THRESHOLD=0.85
# OMR fill ratio: 0–OMR_FILL_EMPTY_MAX = empty bubble
OMR_EMPTY_MAX=0.30
# OMR fill ratio: OMR_FILL_TICKED_MIN–1.0 = ticked bubble; middle band = FLAG
OMR_TICKED_MIN=0.70
# Number of digit boxes in the employee-ID field on the scan form
DIGIT_BOX_COUNT=6
# Scanner DPI assumption used for PDF-point → pixel coordinate conversion
# Must match the DPI used when /generate-form was called AND when scanning
OMR_DPI=300
