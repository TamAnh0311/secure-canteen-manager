[global]
   workgroup = WORKGROUP
   server string = Order Scanner SMB
   security = user
   map to guest = never
   server min protocol = SMB3_00
   smb encrypt = desired
   disable netbios = yes
   interfaces = {{ ansible_facts.default_ipv4.interface }}
   bind interfaces only = yes
   log file = /var/log/samba/log.%m
   max log size = 1000

[{{ samba_share_name }}]
   path = {{ inbox_root }}
   browseable = yes
   read only = no
   guest ok = no
   valid users = {{ samba_user }}
   force group = {{ service_group }}
   create mask = 0660
   force create mode = 0660
   directory mask = 0770
   force directory mode = 0770
   hosts allow = {{ samba_allowed_networks | join(' ') }}
   hosts deny = 0.0.0.0/0
